// Native regression suite, including fixtures independently generated by the
// already-validated JavaScript implementation. Run using scilab-cli -nb -f.
// Explicit exit statuses matter: Scilab otherwise may exit zero after an error.

function ew_test_assert(condition, label)
    global EW_TEST_ASSERTIONS;
    EW_TEST_ASSERTIONS = EW_TEST_ASSERTIONS + 1;
    if ~and(condition) then error("ASSERTION: " + label); end
endfunction

function ew_test_close(actual, expected, tolerance, label)
    ew_test_assert(and(size(actual) == size(expected)), label + " (Dimensionen)");
    if isempty(actual) then return; end
    difference = max(abs(actual - expected));
    ew_test_assert(difference <= tolerance, ..
        label + msprintf(" (max. Abweichung %.16g, Toleranz %.16g)", difference, tolerance));
endfunction

function ew_test_error(expression, label)
    raised = %f;
    try
        execstr(expression);
    catch
        raised = %t;
    end
    ew_test_assert(raised, label);
endfunction

function values = ew_test_sides(winding)
    names = ["A" "B" "C"];
    values = zeros(length(winding.slotLayers), 4);
    for n = 1:length(winding.slotLayers)
        side = winding.slotLayers(n);
        values(n, :) = [side.slot side.layer find(names == side.phase) side.sign];
    end
endfunction

function values = ew_test_coils(winding)
    names = ["A" "B" "C"];
    values = zeros(length(winding.coils), 7);
    for n = 1:length(winding.coils)
        coil = winding.coils(n);
        values(n, :) = [find(names == coil.phase) coil.positiveSlot coil.negativeSlot ..
            coil.span coil.positiveLayer coil.negativeLayer coil.direction];
    end
endfunction

try
    testDirectory = get_absolute_file_path("run_tests.sce");
    exec(testDirectory + "../macros/winding.sci", -1);
    exec(testDirectory + "../macros/spectrum.sci", -1);
    exec(testDirectory + "../macros/inductance.sci", -1);
    exec(testDirectory + "../macros/learning.sci", -1);
    exec(testDirectory + "../macros/graphics.sci", -1);
    exec(testDirectory + "reference-fixtures.sce", -1);
    exec(testDirectory + "layout_reference_fixtures.sci", -1);
    exec(testDirectory + "layout_tests.sci", -1);
    exec(testDirectory + "inductance_tests.sci", -1);
    exec(testDirectory + "learning_tests.sci", -1);
    global EW_TEST_ASSERTIONS;
    EW_TEST_ASSERTIONS = 0;
    phaseNames = ["A" "B" "C"];
    validCases = 0; invalidCases = 0;

    for caseIndex = 1:length(ew_reference_cases)
        fixture = ew_reference_cases(caseIndex);
        input = fixture.input;
        winding = ew_compute_winding(input(1), input(2), input(3), input(4));
        label = fixture.label;
        ew_test_assert(winding.valid == fixture.valid, label + ": Realisierbarkeit");
        ew_test_assert(winding.balanced == fixture.balanced, label + ": Symmetrie");
        ew_test_close(winding.coilSpan, fixture.coilSpan, 0, label + ": Spulenweite");
        kw = zeros(3, 1); angles = zeros(3, 1);
        for phase = 1:3
            kw(phase) = winding.phases(phase).kw;
            angles(phase) = winding.phases(phase).angleDeg;
        end
        ew_test_close(kw, fixture.kw, 1d-9, label + ": Wicklungsfaktoren");
        ew_test_assert(max(ew_angular_distance(angles, fixture.phaseAngles)) < 1d-7, label + ": Strangwinkel");
        ew_test_close(ew_test_sides(winding), fixture.sides, 0, label + ": Tatsaechliche Nutlagen und Vorzeichen");
        ew_test_close(ew_test_coils(winding), fixture.coils, 0, label + ": Vollstaendige Spulenpaarung");
        if ~winding.valid then
            invalidCases = invalidCases + 1;
            ew_test_assert(length(winding.coils) == 0, label + ": Keine erfundenen Spulen");
            ew_test_assert(~ew_compute_spectrum(winding, 20, "A", "phase-sum").valid, label + ": Kein erfundenes Spektrum");
            ew_test_assert(~ew_compute_inductance(winding).valid, label + ": Keine erfundenen Induktivitaeten");
            continue;
        end
        validCases = validCases + 1;
        spectra = list();
        raw = zeros(20, 6);
        for phase = 1:3
            spectrum = ew_compute_spectrum(winding, 20, phaseNames(phase), "phase-sum");
            ew_test_assert(spectrum.valid, label + ": Spektrum " + phaseNames(phase));
            spectra($ + 1) = spectrum;
            for k = 1:20
                coefficient = spectrum.coefficients(k);
                raw(k, 2 * phase - 1) = coefficient.rawReal;
                raw(k, 2 * phase) = coefficient.rawImag;
            end
        end
        ew_test_close(raw, fixture.spectrumRaw, 1d-9, label + ": Gemeinsame rohe Fourierkoeffizienten");
        relative = zeros(20, 3);
        spectrumA = spectra(1);
        for k = 1:20
            coefficient = spectrumA.coefficients(k);
            relative(k, :) = [coefficient.real coefficient.imag coefficient.amplitude];
        end
        ew_test_close(relative, fixture.spectrumRelative, 1d-9, label + ": Fester Spektrumsbezug");
        fundamental = spectrumA.fundamental;
        ew_test_close([fundamental.rawReal fundamental.rawImag fundamental.amplitude], fixture.fundamentalA, 1d-9, label + ": Nutzgrundwelle k=p");
        perCoil = ew_compute_spectrum(winding, 20, "A", "per-coil");
        ew_test_close(perCoil.fundamental.amplitude * spectrumA.coilCountPhase, spectrumA.fundamental.amplitude, 1d-9, label + ": Normierung pro Spule");

        options = struct("maxOrder", 20, "sampleCount", 16, "selectedOrder", winding.polePairs);
        data = ew_compute_inductance(winding, options);
        ew_test_assert(data.valid, label + ": Luftspaltmodell");
        ew_test_close(data.matrixH, fixture.matrixH, 1d-11, label + ": Exakte Induktivitaetsmatrix");
        ew_test_close(data.harmonicMatrixH, fixture.harmonicMatrixH, 1d-11, label + ": Fourier-Induktivitaetsmatrix");
        ew_test_close(data.fundamentalMatrixH, fixture.fundamentalMatrixH, 1d-11, label + ": Grundwellenmatrix");
        ew_test_close(matrix(data.fluxLinkagesWbTurns, 3, 1), fixture.flux, 1d-11, label + ": Flussverkettung");
        ew_test_close(data.energyJ, fixture.energyJ, 1d-11, label + ": Magnetische Energie");
        ew_test_close(data.matrixH, data.matrixH', 1d-13, label + ": Reziprozitaet");
        ew_test_assert(min(real(spec(data.matrixH))) >= -1d-11, label + ": Nichtnegative Energie fuer jeden Stromvektor");
        ew_test_assert(min(real(spec(data.matrixH - data.harmonicMatrixH))) >= -1d-11, label + ": Positive Fourier-Restenergie");
        ew_test_close(data.fluxLinkagesWbTurns, data.matrixH * data.parameters.currents, 1d-13, label + ": Psi=L*i");

        occupied = zeros(winding.slots, winding.layers);
        for n = 1:length(winding.coils)
            coil = winding.coils(n);
            occupied(coil.positiveSlot, coil.positiveLayer) = occupied(coil.positiveSlot, coil.positiveLayer) + 1;
            occupied(coil.negativeSlot, coil.negativeLayer) = occupied(coil.negativeSlot, coil.negativeLayer) + 1;
        end
        ew_test_assert(and(occupied == 1), label + ": Jede Nutlage genau einmal belegt");
        for phase = 1:3
            phaseData = data.phases(phase);
            factor = phaseData.fundamental;
            reconstructed = phaseData.coilCount / winding.polePairs * factor.pitchFactor * ..
                (factor.distributionFactor.real + %i * factor.distributionFactor.imag) * ..
                exp(-%i * winding.polePairs * phaseData.axisRad);
            expected = spectra(phase).fundamental;
            ew_test_close([real(reconstructed) imag(reconstructed)], [expected.rawReal expected.rawImag], 1d-9, label + ": Achsen und Faktoren rekonstruieren C_p");
        end
    end

    // Literal analytic formulas: no per-order sign edits, fitting or extra 3/2.
    for k = 1:20
        expected = [sin(k * %pi / 2) / k, sin(k * %pi / 3) / k, ..
            (2 * cos(k * %pi / 2) * sin(2 * %pi * k / 9) - sin(k * %pi / 6)) / k, ..
            sin(k * %pi / 9) * (-1 + 2 * cos(2 * %pi * k / 9)) / k];
        ids = ["full-pitch" "short-pitch" "chorded-group" "q9-group"];
        for referenceIndex = 1:4
            reference = ew_reference_spectrum(ids(referenceIndex), 20);
            ew_test_close(reference.coefficients(k).real, expected(referenceIndex), 1d-10, "Analytische Referenz " + ids(referenceIndex));
        end
    end
    reference = ew_reference_spectrum("full-pitch", 20);
    ew_test_close(reference.coefficients(3).real, -1 / 3, 1d-12, "Vorzeichen der dritten Vollteilungsordnung");
    ew_test_assert(isempty(reference.fundamentalOrder), "Keine erfundene Maschinenpolpaarzahl fuer Formelbeispiel");

    // Exact result is independent of harmonic truncation and current level.
    winding = ew_compute_winding(9, 4, 2, 1);
    low = ew_compute_inductance(winding, struct("maxOrder", 20, "sampleCount", 16));
    high = ew_compute_inductance(winding, struct("maxOrder", 240, "sampleCount", 16));
    ew_test_close(low.matrixH, high.matrixH, 1d-14, "Exaktes Integral unabhaengig vom Fourierabbruch");
    ew_test_assert(high.relativeTruncationError < low.relativeTruncationError, "Fourier-Konvergenz gegen exaktes Gram-Integral");
    scaled = ew_compute_inductance(winding, struct("turnsPerCoil", 20, "maxOrder", 20, "sampleCount", 16));
    ew_test_close(scaled.matrixH, 4 * low.matrixH, 1d-13, "Quadratische Windungszahlskalierung");
    zero = ew_compute_inductance(winding, struct("currents", [0; 0; 0], "maxOrder", 20, "sampleCount", 16));
    ew_test_close(zero.matrixH, low.matrixH, 1d-14, "Lineare Induktivitaet unabhaengig vom Strom");
    ew_test_close(zero.fluxLinkagesWbTurns, zeros(3, 1), 0, "Flussverkettung bei Strom null ohne Division durch null");
    ew_test_close(zero.energyJ, 0, 0, "Energie bei Strom null");
    integerInput = ew_compute_winding(int32(12), int32(1), int32(1), int32(6));
    ew_test_close(integerInput.q, 2, 0, "Explizite Scilab-Integer behalten reelle Formeln");

    ew_test_error("ew_compute_winding(5,1,1,0)", "Zu kleine Nutenzahl abweisen");
    ew_test_error("ew_compute_winding(12,0,1,0)", "Polpaarzahl null abweisen");
    ew_test_error("ew_compute_winding(12,7,1,0)", "Zu grosse Polpaarzahl abweisen");
    ew_test_error("ew_compute_winding(12,1,3,0)", "Ungueltige Schichtzahl abweisen");
    ew_test_error("ew_compute_winding(12.5,1,1,0)", "Nichtganzzahlige Nuten abweisen");
    ew_test_error("ew_compute_winding(12,1,1,7)", "Zu grosse Spulenweite abweisen");
    ew_test_error("ew_compute_spectrum(winding,121,''A'',''phase-sum'')", "Ungueltige Spektrumsordnung abweisen");
    ew_test_error("ew_compute_spectrum(winding,20,''D'',''phase-sum'')", "Ungueltigen Strang abweisen");
    ew_test_error("ew_compute_inductance(winding,struct(''gapM'',0))", "Luftspalt null abweisen");
    ew_test_error("ew_compute_inductance(winding,struct(''turnsPerCoil'',0))", "Windungszahl null abweisen");

    layoutCases = ew_test_layout();
    independentInductanceChecks = ew_test_inductance();
    EW_TEST_ASSERTIONS = EW_TEST_ASSERTIONS + independentInductanceChecks;
    learningChecks = ew_test_learning();
    EW_TEST_ASSERTIONS = EW_TEST_ASSERTIONS + learningChecks;
    global EW_SCILAB_ROOT;
    EW_SCILAB_ROOT = testDirectory + "../";
    exec(testDirectory + "../macros/export.sci", -1);
    exec(testDirectory + "exports_tests.sci", -1);
    ew_test_exports();
    mprintf("PASS: %d Wicklungsreferenzen (%d gueltig, %d diagnostiziert ungueltig), %d Layoutreferenzen, %d Assertions.\n", ..
        length(ew_reference_cases), validCases, invalidCases, layoutCases, EW_TEST_ASSERTIONS);
    exit(0);
catch
    mprintf("FAIL: %s\n", lasterror());
    exit(1);
end
